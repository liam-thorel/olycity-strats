# Adresse publique du site (sert au retour de la connexion Discord).
PUBLIC_URL=https://strats.olycity.fr
# Appli Discord (celle d'olydiscord). Ajouter dans le portail développeur, OAuth2 → Redirects :
#   https://strats.olycity.fr/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Serveur Discord OLYCITY : seuls ses membres ont accès.
DISCORD_GUILD_ID=343778831766913058
# Durée d'une connexion, et fréquence de revérification de l'appartenance au serveur.
SESSION_DAYS=30
RECHECK_HOURS=6
